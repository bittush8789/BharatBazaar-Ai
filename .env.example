# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Database Connection for PostgreSQL
DATABASE_URL="postgresql://postgres:root@localhost:5432/bharatbazaar_db?schema=public"

# JWT Secret for Microservices Auth
JWT_SECRET="bharatbazaar_microservices_jwt_secret_2025"

# Server Port
PORT=3000

# Node Environment
NODE_ENV=development
